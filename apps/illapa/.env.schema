# @defaultRequired=true
# @defaultSensitive=false
# @currentEnv=$APP_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# Left empty (not `development`): when packages/infra imports this schema the
# deploy's APP_ENV is already resolved and a default here would redefine it.
# @type=enum(development, production) @required=false
APP_ENV=

# Baked into the static HTML at build time, so it must never hold a secret.
# @type=url
PUBLIC_APP_URL=http://localhost:3001

# @type=url
PUBLIC_API_URL=http://localhost:3000
