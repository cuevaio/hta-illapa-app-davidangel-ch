---
import { buttonVariants } from "@hack-the-andes-project/ui/components/button";
import { IllapaLockup } from "@hack-the-andes-project/ui/components/illapa-logo";
import { ENV } from "@/env.public";
import ThemeSwitchIsland from "./theme-switch-island";
---

<header class="absolute inset-x-0 top-0 z-20 border-b border-border bg-background/90 text-foreground">
	<nav
		aria-label="Principal"
		class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-5 py-5 sm:gap-6 sm:px-8"
	>
		<a href="/" class="inline-flex shrink-0 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">
			<IllapaLockup />
		</a>
		<div class="hidden items-center gap-8 md:flex">
			<a href="#vigilancia" class="font-sans text-sm font-medium underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">Qué vigilamos</a>
			<a href="#como-funciona" class="font-sans text-sm font-medium underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">Cómo funciona</a>
			<a href="#fuentes" class="font-sans text-sm font-medium underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">Fuentes</a>
			<a href="#ingenieria" class="font-sans text-sm font-medium underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">Ingeniería</a>
		</div>
		<div class="flex flex-wrap items-center justify-end gap-2 sm:gap-3">
			<ThemeSwitchIsland client:load />
			<a
				href={`${ENV.PUBLIC_APP_URL}/login`}
				class={buttonVariants({ variant: "outline" })}
			>
				Entrar
			</a>
			<a
				href={`${ENV.PUBLIC_APP_URL}/demo`}
				class={buttonVariants({ variant: "default" })}
			>
				Probar demo
			</a>
		</div>
	</nav>
</header>
