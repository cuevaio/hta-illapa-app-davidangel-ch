---
import type { StructureKind } from "@hack-the-andes-project/business/structures/catalog";
import { buttonVariants } from "@hack-the-andes-project/ui/components/button";
import { TopoBackground } from "@hack-the-andes-project/ui/components/contour-art";
import { ViewIcon } from "@hack-the-andes-project/ui/components/icons";
import { StructureArt } from "@hack-the-andes-project/ui/components/structure-art";
import { ENV } from "@/env.public";

interface StructureTemplate {
	kind: Exclude<StructureKind, "entity">;
	label: string;
}

interface Capability {
	title: string;
	description: string;
}

const structureTemplates: StructureTemplate[] = [
	{ kind: "bridge", label: "Puente" },
	{ kind: "tunnel", label: "Túnel" },
	{ kind: "bypass", label: "Variante" },
];

const capabilities: Capability[] = [
	{
		title: "Huaicos sobre el terreno real",
		description:
			"Elige un punto en el mapa del Perú y simula el flujo sobre su relieve. Marca el origen, dibuja bermas o muros de concreto y graba el recorrido para revisarlo cuadro a cuadro.",
	},
	{
		title: "Puentes, túneles y variantes",
		description:
			"Coloca cada obra sobre el relieve de la Carretera Central (PE-22) con la cota y la pendiente a la vista. Ajusta la luz y los pilares del puente, la sección del túnel o los carriles de la variante.",
	},
	{
		title: "Incidentes cerca de cada obra",
		description:
			"Cada estructura lista los incidentes activos a menos de 5 km, con su severidad, la fuente y la hora: las mismas alertas que ILLAPA vigila en las rutas.",
	},
];
---

<section id="ingenieria" aria-labelledby="ingenieria-title" class="border-b border-border">
	<div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-32">
		<div class="grid gap-12 lg:grid-cols-12 lg:items-center">
			<header class="flex flex-col gap-5 lg:col-span-5">
				<p class="type-label text-muted-foreground">Ingeniería · Simuladores</p>
				<h2 id="ingenieria-title" class="type-title">Simula huaicos y modela obras sobre el relieve real</h2>
				<p class="type-lead text-muted-foreground">Para ingenieros civiles y servidores públicos que gestionan infraestructura vial: mira por dónde bajaría un huaico y cómo encaja una obra en el terreno antes de poner la primera piedra.</p>
				<div class="mt-3 flex flex-wrap items-center gap-3">
					<a href={`${ENV.PUBLIC_APP_URL}/demo/ingenieria`} class={buttonVariants({ variant: "default", size: "lg" })}>Probar demo de ingeniería</a>
					<a href={`${ENV.PUBLIC_APP_URL}/login?mode=sign-up`} class={buttonVariants({ variant: "outline", size: "lg" })}>Crear cuenta</a>
				</div>
			</header>
			<div aria-hidden="true" class="relative isolate min-w-0 overflow-hidden rounded-lg border border-border bg-card lg:col-span-7">
				<TopoBackground className="text-foreground/10" />
				<div class="relative grid grid-cols-3 gap-3 px-4 pt-10 pb-6 sm:gap-8 sm:px-10 sm:pt-14 sm:pb-10">
					{structureTemplates.map((template) => (
						<div class="flex flex-col items-center gap-3">
							<div class="aspect-square w-full max-w-44">
								<StructureArt kind={template.kind} className="size-full" />
							</div>
							<span class="type-label text-muted-foreground">{template.label}</span>
						</div>
					))}
				</div>
				<div class="relative flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-t border-border bg-card px-5 py-3">
					<span class="type-data">PE-22 · Carretera Central</span>
					<span class="type-data text-muted-foreground">Relieve real</span>
				</div>
			</div>
		</div>
		<ul class="mt-14 grid gap-8 md:grid-cols-3">
			{capabilities.map((capability) => (
				<li class="flex flex-col gap-4 rounded-lg border border-border bg-card p-5">
					<h3 class="type-heading hyphens-auto">{capability.title}</h3>
					<p class="type-body text-muted-foreground">{capability.description}</p>
				</li>
			))}
		</ul>
		<div class="mt-8 flex flex-col gap-5 rounded-lg border border-border bg-muted p-6 sm:flex-row sm:items-start sm:gap-6 sm:p-8">
			<span class="flex size-12 shrink-0 items-center justify-center rounded-md border border-border bg-card">
				<ViewIcon className="size-6" aria-hidden="true" />
			</span>
			<div class="flex flex-col gap-3">
				<h3 class="type-heading">La experiencia completa, en <span class="whitespace-nowrap">Meta Quest 3</span></h3>
				<p class="type-body max-w-prose text-muted-foreground">Abre ILLAPA en el navegador del visor, coloca la maqueta 1:1000 de tu obra sobre la mesa en realidad mixta y vuela sobre el relieve del Perú en VR. Sin visor, los simuladores funcionan en el navegador de tu computadora.</p>
			</div>
		</div>
	</div>
</section>
