# Values reach the Worker through packages/infra/scraper.ts (alchemy), never
# through process.env at runtime. Secrets live in the gitignored `.env`.
# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$APP_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# Left empty (not `development`): when packages/infra imports this schema the
# deploy's APP_ENV is already resolved and a default here would redefine it.
# @public @type=enum(development, production) @required=false
APP_ENV=

# Shared secret for the manual `POST /run` trigger (header `x-scraper-secret`).
# Generate with: openssl rand -base64 32
# @type=string(minLength=32)
SCRAPER_RUN_SECRET=

# TypeSafe (Jev) API key used to classify scraped news by route relevance.
# @type=string(minLength=8)
JEV_API_KEY=

# Backblaze B2 application key scoped to the `illapa-media` bucket
# (listFiles, writeFiles) used to store SRATMA accident photos.
# @type=string(minLength=8)
B2_MEDIA_KEY_ID=

# @type=string(minLength=8)
B2_MEDIA_APPLICATION_KEY=

# Optional. Origin of the SRATMA relay (deploy/sratma-relay) for deploys whose
# egress SRATMA drops, such as AWS. Empty means calling SRATMA directly.
# @public @type=url @required=false
SRATMA_RELAY_URL=
