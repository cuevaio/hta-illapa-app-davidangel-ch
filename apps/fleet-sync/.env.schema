# Local Alchemy dev loads this schema with Varlock and supplies Worker bindings.
# Dokploy's Node services read process.env through packages/node-runtime.
# Node images do not run Varlock: set values in Dokploy; schema defaults do not apply.
# Gitignored .env files hold local secrets; APP_ENV selects local env overrides.
# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$APP_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production) @required=false
APP_ENV=

# @type=string(minLength=32)
FLEET_SYNC_RUN_SECRET=

# @type=string(minLength=44, maxLength=44)
CREDENTIALS_ENCRYPTION_KEY=

# @public @type=url
OSRM_BASE_URL=https://router.project-osrm.org

# Local Alchemy supplies this binding; Node derives it from DATABASE_URL.
# @required=false
HYPERDRIVE=

# Optional build identity. Set it in Dokploy; local Alchemy resolves it from git.
# @public @type=string @required=false
SERVICE_VERSION=
