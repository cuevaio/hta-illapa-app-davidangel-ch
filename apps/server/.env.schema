# Values reach the Worker through packages/infra/server.ts (alchemy), never
# through process.env at runtime. Secrets live in the gitignored `.env`;
# `.env.production` (tracked) only overrides public URLs for deploys.
# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$APP_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production)
APP_ENV=development

# @public @type=url
BETTER_AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Comma-separated list of browser origins trusted for CORS and better-auth
# (web app, previews, marketing...). Native schemes are added in code. `*`
# matches inside one host label, for hosts like Vercel preview URLs.
# @public @type=string(minLength=1)
ALLOWED_ORIGINS=http://localhost:3001

# @type=string(minLength=40)
CREDENTIALS_ENCRYPTION_KEY=

# @public @type=url
OSRM_BASE_URL=https://router.project-osrm.org

# Optional. Leave it empty to keep POST /api/demo/reset switched off.
# @sensitive @type=string(minLength=32) @required=false
DEMO_RESET_SECRET=
