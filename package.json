{
	"name": "hack-the-andes-project",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @hack-the-andes-project/infra dev",
		"dev:web": "pnpm --filter web dev:bare",
		"dev:illapa": "pnpm --filter @hack-the-andes-project/infra dev --include illapa",
		"dev:quest": "pnpm --filter illapa-quest dev",
		"dev:native": "pnpm --filter native dev",
		"build": "pnpm -r --if-present build",
		"check-types": "pnpm -r check-types",
		"test": "pnpm -r --if-present test",
		"format:write": "biome check --write .",
		"check": "biome check .",
		"db:push": "pnpm --filter @hack-the-andes-project/db db:push",
		"db:generate": "pnpm --filter @hack-the-andes-project/db db:generate",
		"db:migrate": "pnpm --filter @hack-the-andes-project/db db:migrate",
		"db:studio": "pnpm --filter @hack-the-andes-project/db db:studio",
		"deploy": "pnpm --filter @hack-the-andes-project/infra run deploy",
		"deploy:server": "pnpm --filter @hack-the-andes-project/infra deploy:server",
		"deploy:web": "pnpm --filter @hack-the-andes-project/infra deploy:web",
		"deploy:illapa": "pnpm --filter @hack-the-andes-project/infra deploy:illapa",
		"deploy:scraper": "pnpm --filter @hack-the-andes-project/infra deploy:scraper",
		"deploy:fleet-sync": "pnpm --filter @hack-the-andes-project/infra deploy:fleet-sync",
		"deploy:plan": "pnpm --filter @hack-the-andes-project/infra plan",
		"destroy": "pnpm --filter @hack-the-andes-project/infra destroy",
		"logs:server": "pnpm --filter @hack-the-andes-project/infra logs:server",
		"logs:web": "pnpm --filter @hack-the-andes-project/infra logs:web",
		"logs:illapa": "pnpm --filter @hack-the-andes-project/infra logs:illapa",
		"logs:scraper": "pnpm --filter @hack-the-andes-project/infra logs:scraper",
		"logs:fleet-sync": "pnpm --filter @hack-the-andes-project/infra logs:fleet-sync",
		"infra:login": "pnpm --filter @hack-the-andes-project/infra login",
		"infra:refresh": "pnpm --filter @hack-the-andes-project/infra refresh",
		"build:native:android": "pnpm --filter native build:android",
		"build:native:ios": "pnpm --filter native build:ios",
		"build:native:cloud:android": "pnpm --filter native build:android:cloud",
		"build:native:cloud:ios": "pnpm --filter native build:ios:cloud",
		"build:native:prod:android": "pnpm --filter native build:android:prod",
		"build:native:prod:ios": "pnpm --filter native build:ios:prod",
		"build:native:dev-client:android": "pnpm --filter native build:dev-client:android",
		"build:native:dev-client:ios": "pnpm --filter native build:dev-client:ios",
		"submit:native:android": "pnpm --filter native submit:android",
		"submit:native:ios": "pnpm --filter native submit:ios",
		"update:native:preview": "pnpm --filter native update:preview",
		"update:native:prod": "pnpm --filter native update:prod",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/illapa/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/ && varlock codegen --path ./apps/scraper/ && varlock codegen --path ./apps/fleet-sync/",
		"postinstall": "pnpm env:generate",
		"demo:reset": "node --experimental-strip-types apps/server/scripts/demo-reset.ts"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/workers-types": "catalog:",
		"@hack-the-andes-project/config": "workspace:*",
		"@types/node": "^26.4.1",
		"typescript": "^6.0.3",
		"varlock": "catalog:"
	},
	"packageManager": "pnpm@11.21.0"
}
